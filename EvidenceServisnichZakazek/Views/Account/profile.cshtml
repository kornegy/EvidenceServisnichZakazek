@model EvidenceServisnichZakazek.Models.Users;
@{
    ViewData["Title"] = "My profile";
}

<div class="container mt-4">
    <h2>Profile setting</h2>
    <hr/>
    
    <div class="form-group mb-3">
        <label class="fw-bold">Your email: </label>
        <input type="text" class="form-control" id="emailInput" value="@Model?.Email" readonly/>
    </div>
    
    <div class="form-group mb-3">
        <label class="fw-bold">Your fullname: </label>
        <input type="text" class="form-control" id="fullNameInput" value="@Model?.FullName" placeholder="Example: Ivan Ivanov"/>
    </div>
    
    <div class="form-group mb-3">
        <label class="fw-bold">Your number: </label>
        <input type="text" class="form-control" id="numberInput" value="@Model?.PhoneNumber" placeholder="Example: +420775118067"/>
    </div>
    
    <button class="btn btn-primary" id="saveProfileBtn">Save changes</button>
    
    <div id="statusMessage" class="mt-3 fw-bold"></div>
</div>

@section Scripts
{
    <script>
        document.getElementById('saveProfileBtn').addEventListener('click', async function(){
            
            let newName = document.getElementById('fullNameInput').value;
            let newPhoneNumber = document.getElementById('numberInput').value;
            
            let messageBox = document.getElementById('statusMessage');
            
            messageBox.innerHTML = 'Saving...';
            messageBox.className = "mt-3 text-muted";
            
            let newForm = new FormData();
            newForm.append("newFullName", newName);
            newForm.append("newPhoneNumber", newPhoneNumber);
            
            try{
                let response = await fetch('/Account/UpdateProfile', {
                    method: 'POST',
                    body: newForm});
                
                let result = await response.json();
                
                if(result.success)
                {
                    messageBox.innerHTML = result.message;
                    messageBox.className = "mt-3 text-success";
                }
                else{
                    messageBox.innerHTML = result.message;
                    messageBox.className = "mt-3 text-danger";
                }
            }
            catch(error)
                {
                    messageBox.innerText = "Network Error!";
                    messageBox.className = "mt-3 text-danger";
            }
                
        });
    </script>
}
