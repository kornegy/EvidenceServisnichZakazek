@model IEnumerable<EvidenceServisnichZakazek.Models.ServiceOrders>

@{
    ViewData["Title"] = "My orders";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My repair requests 📱</h2>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-2">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-2">@TempData["ErrorMessage"]</div>
        }
        <a asp-action="Create" class="btn btn-primary">+ New request</a>
    </div>

    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark">
        <tr>
            <th>Number</th>
            <th>Device</th>
            <th>Issue description</th>
            <th>Due date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">You don't have any active requests yet.</td>
            </tr>
        }
        else
        {
            foreach (var order in Model)
            {
                <tr>
                    <td><strong>#@order.id</strong></td>
                    <td>@order.PhoneType</td>
                    <td>@order.IssueDescription</td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="badge bg-info text-dark">Status: @order.CurrStatus</span>
                    </td>
                    
                    <td>
                        @if (order.CurrStatus == OrderStatus.Prijato)
                        {
                            <form asp-action="Delete" asp-route-id="@order.id" method="post" 
                                  onsubmit="return confirm('Are you sure you want to cancel this request?');">
                                <button type="submit" class="btn btn-sm btn-danger">🗑️ Cancel</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Cancellation is not possible</span>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>