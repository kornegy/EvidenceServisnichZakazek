@model IEnumerable<EvidenceServisnichZakazek.Models.ServiceOrders>

@{
    ViewData["Title"] = "My orders";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My repair requests</h2>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-2">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-2">@TempData["ErrorMessage"]</div>
        }
        <a asp-action="Create" class="btn btn-primary">+ New request</a>
    </div>
    
    <form method="get" asp-action="Index" class="row g-3 mb-4 bg-light p-3 border rounded">
    
        <div class="col-md-4">
            <label class="form-label fw-bold">Search Device</label>
            <input type="text" name="searchQuery" class="form-control" value="@ViewBag.SearchQuery" placeholder="Example: Samsung..." />
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">Status</label>
            <select name="statusFilter" class="form-select">
                <option value="">All statuses</option>
                <option value="1" selected="@(ViewBag.StatusFilter == 1 ? "selected" : null)">Přijato</option>
                <option value="2" selected="@(ViewBag.StatusFilter == 2 ? "selected" : null)">Diagnostika</option>
                <option value="3" selected="@(ViewBag.StatusFilter == 3 ? "selected" : null)">Oprava</option>
                <option value="4" selected="@(ViewBag.StatusFilter == 4 ? "selected" : null)">Dokončeno</option>
                <option value="5" selected="@(ViewBag.StatusFilter == 5 ? "selected" : null)">Vydáno</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">Date from</label>
            <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100 me-2">Filter</button>
            <a href="/ServiceOrder/Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark">
        <tr>
            <th>Number</th>
            <th>Device</th>
            <th>Issue description</th>
            <th>Due date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">You don't have any active requests yet.</td>
            </tr>
        }
        else
        {
            foreach (var order in Model)
            {
                <tr>
                    <td><strong>#@order.id</strong></td>
                    <td>@order.PhoneType</td>
                    <td>@order.IssueDescription</td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="badge bg-info text-dark">Status: @order.CurrStatus</span>
                    </td>
                    
                    <td>
                        @if (order.CurrStatus == OrderStatus.Prijato)
                        {
                            <form asp-action="Delete" asp-route-id="@order.id" method="post" 
                                  onsubmit="return confirm('Are you sure you want to cancel this request?');">
                                <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Cancellation is not possible</span>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>